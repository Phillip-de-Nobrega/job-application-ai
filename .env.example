# Copy this to .env and fill in your values

# Required for online deployment — set a strong password
JOB_AI_PASSWORD=changeme

# Adzuna free API keys — get at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Email (optional — for follow-up emails)
JOB_AI_SMTP_HOST=smtp.gmail.com
JOB_AI_SMTP_PORT=587
JOB_AI_SMTP_USER=
JOB_AI_SMTP_PASS=
JOB_AI_IMAP_HOST=imap.gmail.com
JOB_AI_IMAP_PORT=993

# CV path (optional — only needed if parsing CV PDF on the server)
# JOB_AI_CV_PATH=/path/to/your/cv.pdf
